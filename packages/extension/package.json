{
  "name": "@diagit/extension",
  "version": "0.4.0",
  "private": true,
  "description": "Diagram viewer & diff browser extension (Chrome, Edge, Firefox) for GitLab & GitHub.",
  "type": "module",
  "license": "MIT",
  "author": "Marco Schäck (https://github.com/emaarco)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "dev:example": "WXT_DEV_EXAMPLE=1 wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "typecheck": "wxt prepare && tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs --output-type err",
    "lint:webext": "web-ext lint --source-dir .output/firefox-mv3",
    "size": "size-limit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:build": "WXT_E2E=1 wxt build && WXT_E2E=1 wxt build -b firefox",
    "test:e2e": "wdio run wdio.conf.ts",
    "test:e2e:live": "WDIO_LIVE=1 wdio run wdio.conf.ts",
    "test:e2e:container": "./e2e/container/run.sh"
  },
  "dependencies": {
    "@diagit/bpmn-diff": "*",
    "@excalidraw/utils": "0.1.8",
    "@miragon/context-maps-renderer": "0.9.1",
    "@miragon/event-storming-renderer": "0.9.0",
    "@miragon/team-topologies-renderer": "0.19.0",
    "@miragon/team-topologies-schema-model": "0.19.0",
    "@miragon/value-chain-renderer": "0.10.0",
    "@miragon/value-chain-schema-model": "0.7.3",
    "@miragon/wardley-renderer": "0.16.1",
    "bpmn-js": "18.31.1",
    "camunda-bpmn-moddle": "8.0.2",
    "dmn-js": "18.0.1",
    "lucide": "1.70.0",
    "webext-alert": "1.1.0",
    "webext-permission-toggle": "7.1.1"
  },
  "devDependencies": {
    "@size-limit/file": "14.3.0",
    "@wdio/cli": "10.2.0",
    "@wdio/globals": "10.2.0",
    "@wdio/local-runner": "10.2.0",
    "@wdio/mocha-framework": "10.2.0",
    "@wdio/spec-reporter": "10.2.0",
    "@wdio/types": "10.2.0",
    "chrome-webstore-upload-cli": "4.0.2",
    "dependency-cruiser": "18.7.2",
    "expect-webdriverio": "8.0.0",
    "happy-dom": "21.0.4",
    "size-limit": "14.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "web-ext": "10.8.0",
    "webdriverio": "10.2.0",
    "wxt": "0.21.5"
  }
}
