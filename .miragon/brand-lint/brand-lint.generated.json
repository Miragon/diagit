  "slopText": [
    {
      "id": "S1",
      "art": "dichte",
      "pro_1000_woerter": 2.5,
      "muster": [
        "\\b(kein|keine|keinen|keinem|keiner|nicht)\\b(?=[^.!?;:\\n]*?\\p{L}{3})[^.!?;:\\n]{1,80}?,\\s+sondern\\b"
      ]
    },
    {
      "id": "S2",
      "art": "fett-liste",
      "max_pro_datei": 5
    },
    {
      "id": "S4",
      "art": "muster",
      "muster": [
        "(^|[.!?]\\s+|\\n[^\\S\\n]*)(Das Ergebnis|Kurz gesagt|Kurzum|Die Folge|Der Clou|Das Beste daran|Fazit|Unterm Strich|Die Wahrheit ist)\\s*:"
      ]
    },
    {
      "id": "S5",
      "art": "muster",
      "muster": [
        "(^\\s*|\\n[^\\S\\n]*\\n[^\\S\\n]*)(Kennst du das|Schon mal|Hast du dich (schon mal |jemals )?gefragt|Stell dir vor|Was wäre, wenn)[^\\n]*"
      ]
    },
    {
      "id": "S6",
      "art": "dichte",
      "pro_1000_woerter": 4,
      "muster": [
        "\\b(wirklich|absolut|extrem|unglaublich|enorm)\\b"
      ]
    }
  ],
  "slopCss": [
    {
      "id": "U5",
      "art": "css",
      "muster": [
        "background-clip:\\s*text"
      ]
    }
  ],
