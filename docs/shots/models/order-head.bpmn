<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_OrderHandling" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_OrderHandling" name="Order handling" isExecutable="true">
    <bpmn:startEvent id="Event_OrderReceived" name="Order received">
      <bpmn:outgoing>Flow_OrderReceivedToCheckOrder</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_CheckOrder" name="Check order and stock">
      <bpmn:incoming>Flow_OrderReceivedToCheckOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckOrderToOrderOk</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_OrderOk" name="Order ok?">
      <bpmn:incoming>Flow_CheckOrderToOrderOk</bpmn:incoming>
      <bpmn:outgoing>Flow_OrderOkToCollectPayment</bpmn:outgoing>
      <bpmn:outgoing>Flow_OrderOkToSendRejection</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_ShipOrder" name="Ship order">
      <bpmn:incoming>Flow_CollectPaymentToShipOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_ShipOrderToOrderShipped</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_OrderShipped" name="Order shipped">
      <bpmn:incoming>Flow_ShipOrderToOrderShipped</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ShipOrderToOrderShipped" sourceRef="Activity_ShipOrder" targetRef="Event_OrderShipped" />
    <bpmn:sequenceFlow id="Flow_OrderOkToCollectPayment" name="yes" sourceRef="Gateway_OrderOk" targetRef="Activity_CollectPayment" />
    <bpmn:sendTask id="Activity_SendRejection" name="Send rejection">
      <bpmn:incoming>Flow_OrderOkToSendRejection</bpmn:incoming>
      <bpmn:outgoing>Flow_SendRejectionToOrderRejected</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_OrderRejected" name="Order rejected">
      <bpmn:incoming>Flow_SendRejectionToOrderRejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_SendRejectionToOrderRejected" sourceRef="Activity_SendRejection" targetRef="Event_OrderRejected" />
    <bpmn:sequenceFlow id="Flow_OrderOkToSendRejection" name="no" sourceRef="Gateway_OrderOk" targetRef="Activity_SendRejection" />
    <bpmn:serviceTask id="Activity_CollectPayment" name="Collect payment">
      <bpmn:incoming>Flow_OrderOkToCollectPayment</bpmn:incoming>
      <bpmn:outgoing>Flow_CollectPaymentToShipOrder</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Event_PaymentOverdue" name="3 days" cancelActivity="false" attachedToRef="Activity_CollectPayment">
      <bpmn:outgoing>Flow_PaymentOverdueToSendReminder</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Activity_SendReminder" name="Send reminder">
      <bpmn:incoming>Flow_PaymentOverdueToSendReminder</bpmn:incoming>
      <bpmn:outgoing>Flow_SendReminderToReminderSent</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_ReminderSent" name="Reminder sent">
      <bpmn:incoming>Flow_SendReminderToReminderSent</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_SendReminderToReminderSent" sourceRef="Activity_SendReminder" targetRef="Event_ReminderSent" />
    <bpmn:sequenceFlow id="Flow_PaymentOverdueToSendReminder" sourceRef="Event_PaymentOverdue" targetRef="Activity_SendReminder" />
    <bpmn:sequenceFlow id="Flow_CollectPaymentToShipOrder" sourceRef="Activity_CollectPayment" targetRef="Activity_ShipOrder" />
    <bpmn:sequenceFlow id="Flow_CheckOrderToOrderOk" sourceRef="Activity_CheckOrder" targetRef="Gateway_OrderOk" />
    <bpmn:sequenceFlow id="Flow_OrderReceivedToCheckOrder" sourceRef="Event_OrderReceived" targetRef="Activity_CheckOrder" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_OrderHandling">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_OrderHandling" bpmnElement="Process_OrderHandling">
      <bpmndi:BPMNShape id="BPMNShape_Event_OrderReceived" bpmnElement="Event_OrderReceived">
        <dc:Bounds x="80" y="121" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="64" y="163" width="68" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_CheckOrder" bpmnElement="Activity_CheckOrder">
        <dc:Bounds x="176" y="99" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Gateway_OrderOk" bpmnElement="Gateway_OrderOk" isMarkerVisible="true">
        <dc:Bounds x="336" y="114" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="324" y="94" width="75" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_ShipOrder" bpmnElement="Activity_ShipOrder">
        <dc:Bounds x="606" y="99" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_OrderShipped" bpmnElement="Event_OrderShipped">
        <dc:Bounds x="766" y="121" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="754" y="163" width="61" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_SendRejection" bpmnElement="Activity_SendRejection">
        <dc:Bounds x="446" y="398" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_OrderRejected" bpmnElement="Event_OrderRejected">
        <dc:Bounds x="638" y="420" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="622" y="462" width="68" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_CollectPayment" bpmnElement="Activity_CollectPayment">
        <dc:Bounds x="446" y="99" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_PaymentOverdue" bpmnElement="Event_PaymentOverdue">
        <dc:Bounds x="503" y="161" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="543" y="181" width="54" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_SendReminder" bpmnElement="Activity_SendReminder">
        <dc:Bounds x="606" y="258" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_ReminderSent" bpmnElement="Event_ReminderSent">
        <dc:Bounds x="766" y="280" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="750" y="322" width="68" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_ShipOrderToOrderShipped" bpmnElement="Flow_ShipOrderToOrderShipped">
        <di:waypoint x="706" y="139" />
        <di:waypoint x="766" y="139" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_OrderOkToCollectPayment" bpmnElement="Flow_OrderOkToCollectPayment">
        <di:waypoint x="386" y="139" />
        <di:waypoint x="446" y="139" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="394" y="121" width="33" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_SendRejectionToOrderRejected" bpmnElement="Flow_SendRejectionToOrderRejected">
        <di:waypoint x="546" y="438" />
        <di:waypoint x="638" y="438" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_OrderOkToSendRejection" bpmnElement="Flow_OrderOkToSendRejection">
        <di:waypoint x="361" y="164" />
        <di:waypoint x="361" y="438" />
        <di:waypoint x="446" y="438" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="369" y="420" width="26" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_SendReminderToReminderSent" bpmnElement="Flow_SendReminderToReminderSent">
        <di:waypoint x="706" y="298" />
        <di:waypoint x="766" y="298" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_PaymentOverdueToSendReminder" bpmnElement="Flow_PaymentOverdueToSendReminder">
        <di:waypoint x="521" y="197" />
        <di:waypoint x="521" y="298" />
        <di:waypoint x="606" y="298" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_CollectPaymentToShipOrder" bpmnElement="Flow_CollectPaymentToShipOrder">
        <di:waypoint x="546" y="139" />
        <di:waypoint x="606" y="139" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_CheckOrderToOrderOk" bpmnElement="Flow_CheckOrderToOrderOk">
        <di:waypoint x="276" y="139" />
        <di:waypoint x="336" y="139" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_OrderReceivedToCheckOrder" bpmnElement="Flow_OrderReceivedToCheckOrder">
        <di:waypoint x="116" y="139" />
        <di:waypoint x="176" y="139" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
